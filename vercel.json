{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/telegram",
      "destination": "/telegram.html"
    },
    {
      "source": "/dispatcher",
      "destination": "/dispatcher.html"
    },
    {
      "source": "/admin-reset",
      "destination": "/admin-reset.html"
    },
    {
      "source": "/r/:path+",
      "destination": "/r.html"
    },
    {
      "source": "/v/:path+",
      "destination": "/v.html"
    }
  ]
}